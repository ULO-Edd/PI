{
  "openapi": "3.0.0",
  "info": {
    "title": "Identity Service Contracts",
    "version": "1.0.0",
    "description": "Endpoints managing user roles and credentials"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate user credentials",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success with secure cookies and user claims payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string", "format": "uuid" },
                        "email": { "type": "string" },
                        "role": { "type": "string", "enum": ["Admin", "Organiser", "Attendee"] }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}