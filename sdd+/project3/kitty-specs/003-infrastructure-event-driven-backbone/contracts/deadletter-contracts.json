{
  "openapi": "3.0.3",
  "info": {
    "title": "Infrastructure Dead-Letter Management API",
    "description": "API contracts for inspecting, replaying, and purging failed messages within the Dead-Letter Queue (DLQ) relational database storage.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/admin/dlq": {
      "get": {
        "summary": "Inspect failed DLQ messages",
        "description": "Retrieve list of failed messages persisted in the DLQ relational failure store with pagination and filtering support. Accessible to Admins only.",
        "operationId": "GetFailedMessages",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Page number to retrieve"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            },
            "description": "Number of records per page"
          },
          {
            "name": "originalQueueName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter by origin queue name"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "totalItems": {
                      "type": "integer"
                    },
                    "page": {
                      "type": "integer"
                    },
                    "pageSize": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DeadLetterEntry"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Valid JWT missing or invalid"
          },
          "403": {
            "description": "Forbidden - User does not have Admin privileges"
          }
        }
      }
    },
    "/api/admin/dlq/{id}": {
      "get": {
        "summary": "Get details of a failed message",
        "description": "Retrieve deep inspection details of a failed message including full stack trace and error history by its ID. Accessible to Admins only.",
        "operationId": "GetFailedMessageById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique database ID of the failed dead letter entry"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeadLetterEntry"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found - Message with specified ID does not exist"
          }
        }
      }
    },
    "/api/admin/dlq/{id}/replay": {
      "post": {
        "summary": "Replay a failed message",
        "description": "Re-publish a failed message from the DLQ database back to its queue of origin, preserving its original correlation ID. Accessible to Admins only.",
        "operationId": "ReplayFailedMessage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique database ID of the failed dead letter entry to replay"
          }
        ],
        "responses": {
          "200": {
            "description": "Message successfully replayed and queued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "replayedMessageId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "correlationId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/admin/dlq/{id}/purge": {
      "delete": {
        "summary": "Purge a failed message",
        "description": "Permanently delete/purge a failed message from the DLQ database. Accessible to Admins only.",
        "operationId": "PurgeFailedMessage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique database ID of the failed dead letter entry to purge"
          }
        ],
        "responses": {
          "200": {
            "description": "Message successfully purged",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeadLetterEntry": {
        "type": "object",
        "required": [
          "id",
          "messageId",
          "correlationId",
          "eventType",
          "originalQueueName",
          "targetConsumer",
          "failureReason",
          "payload",
          "failureTimestamp",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string"
          },
          "originalQueueName": {
            "type": "string"
          },
          "targetConsumer": {
            "type": "string"
          },
          "failureReason": {
            "type": "string"
          },
          "errorStackTrace": {
            "type": "string",
            "nullable": true
          },
          "payload": {
            "type": "string",
            "description": "Raw JSON string containing the original message body payload"
          },
          "failureTimestamp": {
            "type": "string",
            "format": "date-time"
          },
          "retryHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RetryHistoryItem"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "PendingAction",
              "Replayed",
              "Purged"
            ]
          }
        }
      },
      "RetryHistoryItem": {
        "type": "object",
        "required": [
          "attemptNumber",
          "timestamp",
          "errorMessage"
        ],
        "properties": {
          "attemptNumber": {
            "type": "integer"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "errorMessage": {
            "type": "string"
          }
        }
      }
    }
  }
}
